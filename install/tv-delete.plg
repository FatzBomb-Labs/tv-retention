<?xml version='1.0' encoding='utf-8'?>
<PLUGIN name="tv-delete" author="FatzServer" version="2026.09.06" launch="Tools/TVDelete" icon="trash" category="stable" min="7.0.0">
  <CHANGES>2026.09.06: First release. Per-show retention by days, episodes, or seasons, set directly or through named presets; mandatory Sonarr matching across multiple instances with auto-detected root path mapping; optional re-monitoring when a rule is widened; scheduled runs; dry run; deletion guards; optional TMDB air dates; run journal and history.</CHANGES>
  <FILE Name="/boot/config/plugins/tv-delete/tv-delete-2026.09.06-noarch-1.txz" Type="base64">
    <INLINE></INLINE>
    <SHA256>abfdbc4b33eb2bfbc75525e31dbc17a7b6ed7f1ac7135a7fdb8603d8a194e9f6</SHA256>
  </FILE>
  <FILE Run="/bin/bash">
    <INLINE>
set -eu
test -x /usr/bin/python3 || { echo 'Python 3.9+ is required at /usr/bin/python3.'; exit 1; }
/usr/bin/python3 -c 'import sys; assert sys.version_info &gt;= (3, 9), "Python 3.9+ required"'
test -f /boot/config/plugins/tv-delete/tv-delete-2026.09.06-noarch-1.txz || { echo 'Package missing at /boot/config/plugins/tv-delete/tv-delete-2026.09.06-noarch-1.txz.'; exit 1; }
echo 'abfdbc4b33eb2bfbc75525e31dbc17a7b6ed7f1ac7135a7fdb8603d8a194e9f6  /boot/config/plugins/tv-delete/tv-delete-2026.09.06-noarch-1.txz' | sha256sum -c -
upgradepkg --install-new --reinstall /boot/config/plugins/tv-delete/tv-delete-2026.09.06-noarch-1.txz
chmod 755 /usr/local/emhttp/plugins/tv-delete/event/*
# Republish the schedule from the saved settings; a fresh install has none, and an
# upgrade keeps whatever the operator had configured.
/usr/bin/python3 /usr/local/emhttp/plugins/tv-delete/worker/main.py resume || true
echo 'TV Delete installed. Open Tools &gt; TV Delete. Dry run is ON and no schedule is set.'
</INLINE>
  </FILE>
  <FILE Run="/bin/bash" Method="remove">
    <INLINE>
set -eu
# Only the plugin's own cron entry and package are removed. Settings, journals and
# history are left in place so a reinstall picks up where it left off.
if [ -f /boot/config/plugins/tv-delete/schedule.cron ]; then unlink /boot/config/plugins/tv-delete/schedule.cron; fi
/usr/local/sbin/update_cron
removepkg tv-delete
echo 'TV Delete removed. Settings and run journals were preserved.'
</INLINE>
  </FILE>
</PLUGIN>