<?xml version='1.0' encoding='utf-8'?>
<PLUGIN name="tv-retention" author="FatzServer" version="2026.09.06" launch="Tools/TVRetention" icon="trash" category="stable" min="7.0.0">
  <CHANGES>2026.09.06: First release. Per-show retention by days, episodes, or seasons, set directly or through named presets; mandatory Sonarr matching across multiple instances with auto-detected root path mapping; optional re-monitoring when a rule is widened; scheduled runs; dry run; deletion guards; optional TMDB air dates; run journal and history.</CHANGES>
  <FILE Name="/boot/config/plugins/tv-retention/tv-retention-2026.09.06-noarch-1.txz" Type="base64">
    <INLINE></INLINE>
    <SHA256>de4a49c2c3da782d6dd068f89dae12e1e6c432d64e5e89fdaa6e1651d407110b</SHA256>
  </FILE>
  <FILE Run="/bin/bash">
    <INLINE>
set -eu
test -x /usr/bin/python3 || { echo 'Python 3.9+ is required at /usr/bin/python3.'; exit 1; }
/usr/bin/python3 -c 'import sys; assert sys.version_info &gt;= (3, 9), "Python 3.9+ required"'
test -f /boot/config/plugins/tv-retention/tv-retention-2026.09.06-noarch-1.txz || { echo 'Package missing at /boot/config/plugins/tv-retention/tv-retention-2026.09.06-noarch-1.txz.'; exit 1; }
echo 'de4a49c2c3da782d6dd068f89dae12e1e6c432d64e5e89fdaa6e1651d407110b  /boot/config/plugins/tv-retention/tv-retention-2026.09.06-noarch-1.txz' | sha256sum -c -
upgradepkg --install-new --reinstall /boot/config/plugins/tv-retention/tv-retention-2026.09.06-noarch-1.txz
chmod 755 /usr/local/emhttp/plugins/tv-retention/event/*
# Republish the schedule from the saved settings; a fresh install has none, and an
# upgrade keeps whatever the operator had configured.
/usr/bin/python3 /usr/local/emhttp/plugins/tv-retention/worker/main.py resume || true
echo 'TV Retention installed. Open Tools &gt; TV Retention. Dry run is ON and no schedule is set.'
</INLINE>
  </FILE>
  <FILE Run="/bin/bash" Method="remove">
    <INLINE>
set -eu
# Only the plugin's own cron entry and package are removed. Settings, journals and
# history are left in place so a reinstall picks up where it left off.
if [ -f /boot/config/plugins/tv-retention/schedule.cron ]; then unlink /boot/config/plugins/tv-retention/schedule.cron; fi
/usr/local/sbin/update_cron
removepkg tv-retention
echo 'TV Retention removed. Settings and run journals were preserved.'
</INLINE>
  </FILE>
</PLUGIN>