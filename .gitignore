# ============================================================
# TV Retention
# ============================================================


# ------------------------------------------------------------
# Python
# ------------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class

.venv/
venv/
env/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
.coverage
.coverage.*
coverage.xml
htmlcov/


# ------------------------------------------------------------
# Local configuration / secrets
# ------------------------------------------------------------

.env
.env.*
!.env.example

*.local
*.local.json
*.local.yaml
*.local.yml

# Local Docker overrides
docker-compose.override.yml
compose.override.yml


# ------------------------------------------------------------
# Runtime application data
# ------------------------------------------------------------

# Container /config data is runtime state and may contain
# credentials, settings, caches, journals, posters, etc.
config/

# Other local runtime/state directories
data/
state/
runtime/


# ------------------------------------------------------------
# Build / generated output
# ------------------------------------------------------------

.build/
build/
dist/
out/

.cache/
tmp/
temp/


# ------------------------------------------------------------
# Development / scratch material
# ------------------------------------------------------------

.dev/
scratch/
screenshots/
reference/

# Reference screenshots and scratch images are not project assets.
# Application images under src/ ARE part of the project.
*.png
!src/**/*.png

*.bak
*.backup
*.tmp
*.temp
*.orig
*.rej
*~
.#*


# ------------------------------------------------------------
# Logs / process files
# ------------------------------------------------------------

*.log
*.log.*
*.pid
*.pid.lock


# ------------------------------------------------------------
# Node / JavaScript tooling
#
# The project currently requires no Node dependency tree, but
# ignore one if local development tooling creates it.
# ------------------------------------------------------------

node_modules/
.npm/
.yarn/
.pnpm-store/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ------------------------------------------------------------
# IDE / editor
# ------------------------------------------------------------

.idea/
.vscode/
*.code-workspace

*.swp
*.swo


# ------------------------------------------------------------
# OS-generated files
# ------------------------------------------------------------

.DS_Store
.AppleDouble
.LSOverride
._*

Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/


# ------------------------------------------------------------
# Local archives / packaged copies
# ------------------------------------------------------------

*.zip
*.tar
*.tar.gz
*.tgz
*.7z