<?php
$tvrBase = '/usr/local/emhttp/plugins/tv-retention';
$tvrToken = htmlspecialchars($var['csrf_token'] ?? '', ENT_QUOTES, 'UTF-8');
// Cache key derived from the asset contents, never from their timestamps. The package
// deliberately ships every file with mtime 0 so builds stay reproducible, which means a
// timestamp-based key collapses to the same string for every release and a browser then
// serves a stale script after an upgrade. Hashing ~60KB per render is cheap and is right
// whether the files arrived from a package, an upgrade, or a hand copy.
$tvdAsset = @md5_file("$tvrBase/assets/app.js") . @md5_file("$tvrBase/assets/app.css");
$tvdAsset = $tvdAsset ? substr($tvdAsset, 0, 12)
                      : trim((string)@file_get_contents("$tvrBase/VERSION"));
?>
<link rel="stylesheet" href="/plugins/tv-retention/assets/app.css?v=<?=rawurlencode($tvdAsset)?>">
<div id="tv-retention" data-csrf="<?=$tvrToken?>" data-api="/plugins/tv-retention/include/api.php">
<?php readfile("$tvrBase/include/interface.html"); ?>
</div>
<script src="/plugins/tv-retention/assets/app.js?v=<?=rawurlencode($tvdAsset)?>"></script>
