<?php
$tvdBase = '/usr/local/emhttp/plugins/tv-delete';
$tvdToken = htmlspecialchars($var['csrf_token'] ?? '', ENT_QUOTES, 'UTF-8');
// Cache key for the assets. The package ships with a fixed mtime so rebuilds stay
// reproducible, which means the version has to carry the change; the mtimes are folded in
// as well so a file replaced in place is picked up without a reinstall.
$tvdVersion = trim((string)@file_get_contents("$tvdBase/VERSION"));
$tvdStamp = max((int)@filemtime("$tvdBase/assets/app.css"), (int)@filemtime("$tvdBase/assets/app.js"));
$tvdAsset = rawurlencode(($tvdVersion ?: 'dev') . '-' . $tvdStamp);
?>
<link rel="stylesheet" href="/plugins/tv-delete/assets/app.css?v=<?=$tvdAsset?>">
<div id="tv-delete" data-csrf="<?=$tvdToken?>" data-api="/plugins/tv-delete/include/api.php">
<?php readfile("$tvdBase/include/interface.html"); ?>
</div>
<script src="/plugins/tv-delete/assets/app.js?v=<?=$tvdAsset?>"></script>
